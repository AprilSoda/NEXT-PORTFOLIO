# ─────────────────────────────────────────────────────────────
# Notion (official SDK) — database queries
# ─────────────────────────────────────────────────────────────
NOTION_TOKEN=               # Notion integration token (secret_...)
NOTION_DATABASE_ID=         # Works/Projects database id
NOTION_DATABASE_ID2=        # Blog posts database id

# Journal pages are published to web, so NotionX needs no auth token.
# NOTION_MOCK=1 serves sample rows instead of calling Notion (npm run build:mock)
NOTION_MOCK=
# NOTION_SNAPSHOT=/path/to/notion-snapshot.json  # real content from a saved export, no token

# ─────────────────────────────────────────────────────────────
# Contact form email (nodemailer / SMTP)
# ─────────────────────────────────────────────────────────────
MAIL_USER=                  # SMTP account (smtp.hiworks.com)
MAIL_PASS=                  # SMTP password

# ─────────────────────────────────────────────────────────────
# Analytics (optional)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ANALYTICS=   # GA4 measurement id (G-XXXXXXX)
# ─────────────────────────────────────────────────────────────
# Cloudflare R2 — image bucket (migration: scripts/migrate-images-to-r2.mjs)
# Create a bucket + API token in the Cloudflare dashboard. NEXT_PUBLIC_R2_PUBLIC_BASE
# is the public base URL (r2.dev now, custom domain later).
# ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-images
NEXT_PUBLIC_R2_PUBLIC_BASE=

# ─────────────────────────────────────────────────────────────
# Showreel (homepage "Play Showreel" modal — self-hosted MP4, no YouTube UI)
# Upload your reel to R2 and point these at it (full URLs).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SHOWREEL_URL=       # e.g. https://<your-r2-base>/showreel.mp4
NEXT_PUBLIC_SHOWREEL_POSTER=    # optional; defaults to /showreel-poster.webp
NEXT_PUBLIC_HERO_BG_URL=        # optional; hero background loop (defaults to the R2 hero-bg.mp4)
